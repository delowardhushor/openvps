{
  "name": "openvps",
  "version": "0.5.0",
  "private": true,
  "description": "Open-source, self-hosted VPS management panel",
  "license": "MIT",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build -w server && npm run build -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm test -w server",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:agent": "npm run dev:agent -w server",
    "package": "bash scripts/package-release.sh"
  }
}
