[Unit]
Description=OpenVPS agent (privileged helper for the panel)
Documentation=https://github.com/delowardhushor/openvps/blob/main/docs/architecture.md
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=NODE_ENV=production
Environment=OPENVPS_CONFIG=/etc/openvps/config.json
ExecStart=/opt/openvps/node/bin/node --disable-warning=ExperimentalWarning /opt/openvps/current/server/dist/agent.js
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
# Never take PM2 daemons or apps down with the agent if one was ever started from it.
KillMode=process
TimeoutStopSec=10

# The socket lives here; the agent sets it to root:openvps 0750 so only the panel can connect.
RuntimeDirectory=openvps-agent
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
StateDirectory=openvps-agent
UMask=0077

# Moderate sandboxing: the agent needs root's PM2 home (/root/.pm2) and runuser,
# so /home and /root stay visible; the OS directories are read-only except the
# Nginx and Let's Encrypt directories it manages sites and certificates in.
ProtectSystem=full
ReadWritePaths=-/etc/nginx -/etc/letsencrypt
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
